# Go build artifacts
/bin/
/dist/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out

# Coverage files
coverage.out
coverage.html
cover.out
*.coverprofile

# Local environment files (keep the example)
.env
.env.*
!.env.example

# Keys and certs — never commit secrets.
# The one exception is the read-only golden test-only party key
# (testdata/golden/testonly-party-private.key, ADR-004). The gateway
# signing key is never mirrored and stays ignored.
*.pem
*.key
!testdata/golden/testonly-party-private.key

# IDE and OS files
.idea/
.vscode/
*.swp
*~
.DS_Store
Thumbs.db

# Scratch archives
**/.archive/**
