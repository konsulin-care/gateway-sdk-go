{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "packageRules": [
    {
      "description": "Group all non-major updates under one chore(deps) prefix",
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "all non-major updates",
      "commitMessagePrefix": "chore(deps):"
    },
    {
      "description": "Keep go.mod tidy after every module update",
      "matchManagers": ["gomod"],
      "postUpdateOptions": ["gomodTidy"]
    },
    {
      "description": "Bump tool versions pinned in .mise.toml",
      "matchManagers": ["mise"],
      "enabled": true
    },
    {
      "description": "Pin GitHub Actions to full commit digests",
      "matchManagers": ["github-actions"],
      "pinDigests": true
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Bump the pinned gateway docker tag in the PR check workflow",
      "managerFilePatterns": ["/^\\.github\\/workflows\\/pr-check\\.yml$/"],
      "matchStrings": [
        "image:\\s*(?<depName>ghcr\\.io\\/[^:\\s]+):(?<currentValue>[^\\s#]+)"
      ],
      "datasourceTemplate": "docker"
    }
  ]
}
